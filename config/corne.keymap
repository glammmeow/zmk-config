#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#define DEFAULT 0
#define LOWER   1
#define MIDDLE  2
#define RAISE   3

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ENT  |
//                   | RSE | MDDL | LWR |   | SPC | ALT  | CMD |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp ENTER
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
                      &mo 3 &mo 2 &mo 1   &kp SPACE &kp LALT &kp LEFT_GUI
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  ESC |     |     |     |     |     |   |     | PGUP|  UP |PGDN |     |      |
// |      |     |     |     |     |     |   |     |LEFT | DWN | RIT |     |      |
// | CAP  |     |     |     |     |     |   |     | GUL | TAB |     |     |      |
//                    |     |     |     |   | CTL | ALT | DEL |
                 bindings = <
   &kp ESC &kp LG(R)   &trans &trans   &trans   &trans      &trans  &kp PG_UP   &kp UP &kp PG_DN   &trans  &trans
   &trans  &trans   &trans &trans   &trans   &trans      &trans  &kp LEFT   &kp DOWN &kp RIGHT  &trans   &trans
   &kp CAPS  &trans &trans &trans   &trans   &trans      &trans  &kp RG(LS(LEFT))  &kp TAB &trans   &trans    &trans
                             &trans &trans   &trans      &kp LALT &kp LCTRL  &kp DEL
                        >;
                };

                middle_layer {
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     | . |  7  |  8  |  9  |  0  |     | BSPC |
// |      |     |     |     |     |     | - |  4  |  5  |  6  |  /  |     |      |
// |      |     |     |     |     |     | + |  1  |  2  |  3  |  *  |     |      |
//                    |     |     |     | = |     |     |     |
                        bindings = <
   &trans &trans  &trans &trans  &trans  &trans     &kp DOT &kp N7 &kp N8  &kp N9 &kp N0 &kp BSPC
   &trans &trans  &trans &trans  &trans  &trans     &kp MINUS  &kp N4 &kp N5  &kp N6 &kp FSLH &trans
   &trans &trans  &trans &trans  &trans  &trans     &kp PLUS &kp N1 &kp N2  &kp N3 &kp ASTRK  &trans
                         &trans    &trans  &trans     &kp EQUAL   &trans    &trans
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |reset|   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// |      |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  "   |
// |      |     |     |     |     |     |   |  _  |  +  |  {  |  }  |     |      |
//                    |     |     |     |   |     |     |     |
                        bindings = <
   &trans &trans   &trans &trans  &trans  &bt BT_CLR_ALL     &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &trans &trans   &trans &trans  &trans   &trans     &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &trans
   &trans &trans   &trans &trans  &trans   &trans     &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &trans   &trans
                         &trans    &trans  &trans      &trans   &trans    &trans
                        >;
                  };
            };
      };
